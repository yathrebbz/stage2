# ═══════════════════════════════════════════════════════
# Smart Room & Financial Monitoring System — .env.example
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────
APP_ENV=development               # development | staging | production
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ─── Security ───────────────────────────────────────────
SECRET_KEY=your-secret-key-min-32-chars-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ─── PostgreSQL ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_room
POSTGRES_USER=smart_room_user
POSTGRES_PASSWORD=your-postgres-password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── InfluxDB ───────────────────────────────────────────
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=smart-room-org
INFLUXDB_BUCKET=sensor_data
INFLUXDB_BUCKET_RETENTION_DAYS=7

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your-redis-password
REDIS_CACHE_TTL_SECONDS=300

# ─── MQTT ───────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_CLIENT_ID=backend-service
MQTT_USERNAME=backend
MQTT_PASSWORD=your-mqtt-password
MQTT_TLS_ENABLED=true
MQTT_CA_CERT_PATH=./certs/ca.crt

# ─── ML Service ─────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_API_KEY=your-ml-service-key
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=smart_room_ml

# ─── Notifications ──────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@smartroom.example.com
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_PHONE=+1234567890

# ─── Financial Defaults ────────────────────────────────
DEFAULT_ELECTRICITY_RATE_EUR_KWH=0.18
DEFAULT_MONTHLY_BUDGET_EUR=100.0
DEFAULT_TIMEZONE=Europe/Paris

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://smartroom.example.com

# ─── Monitoring ─────────────────────────────────────────
PROMETHEUS_ENABLED=true
JAEGER_ENABLED=false
JAEGER_HOST=localhost
JAEGER_PORT=6831

# ─── Storage (for ML model artifacts) ──────────────────
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=eu-west-3
S3_BUCKET_ML_MODELS=smart-room-ml-models

# ─── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20
